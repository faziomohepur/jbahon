 {
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jbahon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "observability": {
    "enabled": true
  },
  
  
  "kv_namespaces": [
    {
      "binding": "KV",
